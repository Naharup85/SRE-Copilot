        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(sre_copilot_docker_container_status{app_id=~\"$app_id\"}, environment_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Environment ID",
        "multi": true,
        "name": "environment_id",
        "query": {
          "query": "label_values(sre_copilot_docker_container_status{app_id=~\"$app_id\"}, environment_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(sre_copilot_docker_container_status{app_id=~\"$app_id\", environment_id=~\"$environment_id\"}, container_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "query": {
          "query": "label_values(sre_copilot_docker_container_status{app_id=~\"$app_id\", environment_id=~\"$environment_id\"}, container_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
