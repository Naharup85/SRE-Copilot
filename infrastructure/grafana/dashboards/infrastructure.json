{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Core Service Health & Workload Summary",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Prometheus Server",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"prometheus\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 2,
      "title": "Backend API Service",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max(up{job=\"sre-copilot-backend\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 3,
      "title": "Monitored Tenant Apps",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(count by (app_id) (sre_copilot_http_requests_total{app_id!=\"sre-copilot-backend\"})) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 4,
      "title": "Active Docker Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(sre_copilot_docker_container_status{status=\"running\"} == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 5,
      "title": "Active K8s Pods",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(sre_copilot_kubernetes_pod_status{ready=\"true\"} == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "teal", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Platform Runtime Performance",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Backend Process CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(sre_copilot_process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU Usage (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15 },
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "id": 7,
      "title": "Backend Memory Usage (RSS vs Heap)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sre_copilot_process_resident_memory_bytes",
          "legendFormat": "Resident Set Size (RSS)",
          "refId": "A"
        },
        {
          "expr": "sre_copilot_nodejs_heap_size_used_bytes",
          "legendFormat": "Node.js Heap Used",
          "refId": "B"
        },
        {
          "expr": "sre_copilot_nodejs_heap_size_total_bytes",
          "legendFormat": "Node.js Heap Total",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Node.js Event Loop & Prometheus Scrape Diagnostics",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Node.js Event Loop Delay",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sre_copilot_nodejs_eventloop_lag_p50_seconds * 1000",
          "legendFormat": "p50 Delay (ms)",
          "refId": "A"
        },
        {
          "expr": "sre_copilot_nodejs_eventloop_lag_p99_seconds * 1000",
          "legendFormat": "p99 Delay (ms)",
          "refId": "B"
        },
        {
          "expr": "sre_copilot_nodejs_eventloop_lag_max_seconds * 1000",
          "legendFormat": "Max Delay (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "ms"
        }
      }
    },
    {
      "id": 9,
      "title": "Prometheus Scrape Duration & Head Series",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "Scrape Latency - {{job}}",
          "refId": "A"
        },
        {
          "expr": "prometheus_tsdb_head_series / 1000",
          "legendFormat": "Head Series (k)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 }
        }
      }
    }
  ],
  "refresh": "10s",
